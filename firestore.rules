rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global catch-all deny default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }

    match /books/{bookId} {
      allow get: if isSignedIn() && isValidId(bookId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(bookId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(bookId) && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(bookId) && resource.data.userId == request.auth.uid;

      match /pages/{pageId} {
        allow get: if isSignedIn() && isValidId(bookId) && isValidId(pageId) && get(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid;
        allow list: if isSignedIn() && isValidId(bookId) && get(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(bookId) && isValidId(pageId) && get(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(bookId) && isValidId(pageId) && get(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid;
        allow delete: if isSignedIn() && isValidId(bookId) && isValidId(pageId) && get(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid;
      }

      match /weeks/{weekId} {
        allow get: if isSignedIn() && isValidId(bookId) && isValidId(weekId) && get(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid;
        allow list: if isSignedIn() && isValidId(bookId) && get(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(bookId) && isValidId(weekId) && get(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(bookId) && isValidId(weekId) && get(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid;
        allow delete: if isSignedIn() && isValidId(bookId) && isValidId(weekId) && get(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid;
      }
    }
  }
}

