rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global catch-all deny default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }

    match /test/{testId} {
      allow read: if true;
    }

    match /authors/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == userId;

      match /profile/{profileId} {
        allow get, list, create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /books/{bookId} {
      allow get: if isSignedIn() && isValidId(bookId) && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous' || !('userId' in resource.data));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous' || !('userId' in resource.data));
      allow create: if isSignedIn() && isValidId(bookId);
      allow update: if isSignedIn() && isValidId(bookId) && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous' || !('userId' in resource.data));
      allow delete: if isSignedIn() && isValidId(bookId) && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous' || !('userId' in resource.data));

      match /pages/{pageId} {
        allow get, list, create, update, delete: if isSignedIn() && isValidId(bookId);
      }

      match /weeks/{weekId} {
        allow get, list, create, update, delete: if isSignedIn() && isValidId(bookId);
      }

      match /glossary/{glossaryId} {
        allow get, list, create, update, delete: if isSignedIn() && isValidId(bookId);
      }
    }
  }
}

